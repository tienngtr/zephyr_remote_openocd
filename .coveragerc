[run]
branch = True
source =
    python/zephyr_remote_openocd
    runners
    scripts
    zephyr
# The deployment bootstrap runs only as python3 -c source text, which coverage
# cannot attribute to its file; tests/unit/test_deployment.py executes it.
omit =
    scripts/contributor/static_check.py
    python/zephyr_remote_openocd/controller/_deployment_bootstrap.py
patch = subprocess
relative_files = True

[report]
show_missing = True
